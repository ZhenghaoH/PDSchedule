# Ascend 910B Mooncake P2P example - one config for both nodes.
#
# Copy this file to config.env next to it, then edit the values for your lab:
#   cp examples/ascend/config.example.env examples/ascend/config.env
#
# Paths are resolved inside the runtime environment: the container named by
# CONTAINER_NAME when it is set, otherwise the shell that runs start.sh.
# The container must use host networking (or publish every port below) so that
# the two nodes can reach each other on these addresses.

# --- runtime -------------------------------------------------------------
# Empty means "launch in the current shell". Set it to a running container
# that already has vLLM-Ascend, torch-npu and Mooncake installed.
CONTAINER_NAME=
REPO=/workspace/PDSchedule
MODEL_PATH=/models/Qwen3-8B
MODEL_NAME=Qwen3-8B
LOG_DIR=/workspace/pdschedule-logs

# CANN environment script inside the runtime.
CANN_SET_ENV=/usr/local/Ascend/ascend-toolkit/set_env.sh

# --- nodes ---------------------------------------------------------------
# s1 hosts prefill and the Controller; s2 hosts decode. One P and one D
# instance in total, each TP1. Replace the documentation-only IP addresses
# below with the routable host addresses used by your two nodes.
S1_HOST=192.0.2.10
S1_NPU=0
S2_HOST=192.0.2.20
S2_NPU=0
CONTROLLER_HOST=192.0.2.10

# --- ports ---------------------------------------------------------------
CONTROLLER_PORT=8000
GATEWAY_P_PORT=8100
GATEWAY_D_PORT=8200
INSTANCE_P_PORT=7100
INSTANCE_D_PORT=7200
VLLM_P_PORT=7101
VLLM_D_PORT=7201
# AscendDirectTransport picks a random port in [20000, 20000 + cards*1000),
# which reaches 28000 on an 8-card node. Keep both KV ports above that range
# and keep them different between the P and D engines.
KV_PORT_P=36000
KV_PORT_D=36200

# --- model and engine ----------------------------------------------------
TP_SIZE=1
MAX_MODEL_LEN=16384
MAX_BATCHED_TOKENS=8192
GPU_UTIL=0.80

# --- PDSchedule connector ------------------------------------------------
# All four entry points below must use the same name and version:
# gatewayP, gatewayD, instanceP, instanceD.
CONNECTOR_NAME=mooncake_p2p_ascend
CONNECTOR_VERSION=1

# --- gateway hardware hints (optional) -----------------------------------
# Consumed by gateway scoring. These are 910B-class values; adjust them to
# the numbers measured on your node if you compare scheduling results.
MY_GPU_TYPE="Ascend 910B"
MY_FLOPS=280
MY_MAX_PROMPT_THROUGHPUT=37829
MY_MEM_BANDWIDTH=800
MY_MAX_DECODE_REQ_NUM=128
